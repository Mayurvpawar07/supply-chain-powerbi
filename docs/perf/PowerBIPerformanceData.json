ADDISSUBTOTAL('dim_location'[location_name], \"IsGrandTotalRowTotal\"),\r\n\t\t\tROLLUPADDISSUBTOTAL('dim_product'[category], \"IsGrandTotalColumnTotal\"),\r\n\t\t\t\"Inventory_Value__SLOW_\", '_Measures'[Inventory Value (SLOW)]\r\n\t\t)\r\n\r\n\tVAR __DS0PrimaryWindowed = \r\n\t\tTOPN(\r\n\t\t\t102,\r\n\t\t\tSUMMARIZE(__DS0Core, 'dim_location'[location_name], [IsGrandTotalRowTotal]),\r\n\t\t\t[IsGrandTotalRowTotal],\r\n\t\t\t0,\r\n\t\t\t'dim_location'[location_name],\r\n\t\t\t1\r\n\t\t)\r\n\r\n\tVAR __DS0SecondaryBase = \r\n\t\tSUMMARIZE(__DS0Core, 'dim_product'[category], [IsGrandTotalColumnTotal])\r\n\r\n\tVAR __DS0Secondary = \r\n\t\tTOPN(102, __DS0SecondaryBase, [IsGrandTotalColumnTotal], 1, 'dim_product'[category], 1)\r\n\r\n\tVAR __DS0BodyLimited = \r\n\t\tNATURALLEFTOUTERJOIN(\r\n\t\t\t__DS0PrimaryWindowed,\r\n\t\t\tSUBSTITUTEWITHINDEX(\r\n\t\t\t\t__DS0Core,\r\n\t\t\t\t\"ColumnIndex\",\r\n\t\t\t\t__DS0Secondary,\r\n\t\t\t\t[IsGrandTotalColumnTotal],\r\n\t\t\t\tASC,\r\n\t\t\t\t'dim_product'[category],\r\n\t\t\t\tASC\r\n\t\t\t)\r\n\t\t)\r\n\r\nEVALUATE\r\n\t__DS0Secondary\r\n\r\nORDER BY\r\n\t[IsGrandTotalColumnTotal], 'dim_product'[category]\r\n\r\nEVALUATE\r\n\t__DS0BodyLimited\r\n\r\nORDER BY\r\n\t[IsGrandTotalRowTotal] DESC, 'dim_location'[location_name], [ColumnIndex]","RowCount":64}},{"name":"Execute Query","component":"AS","start":"2026-10-27T18:05:55.443Z","end":"2026-10-27T18:05:55.667Z","id":"F445E592-A76C-4745-96F7-219E7C835469","parentId":"02c697d3-ca91-4f5a-8603-0900c5419819"},{"name":"Serialize Rowset","component":"AS","start":"2026-10-27T18:05:55.667Z","end":"2026-10-27T18:05:55.667Z","id":"4AC3A46C-47B2-4DD1-9499-856577226285","parentId":"F445E592-A76C-4745-96F7-219E7C835469"}],"sessionId":"b0a97d98-a8a3-4fb6-babe-538db75749cf"}