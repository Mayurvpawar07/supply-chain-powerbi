R __DS0PrimaryWindowed = \r\n\t\tTOPN(\r\n\t\t\t102,\r\n\t\t\tSUMMARIZE(__DS0Core, 'dim_location'[location_name], [IsGrandTotalRowTotal]),\r\n\t\t\t[IsGrandTotalRowTotal],\r\n\t\t\t0,\r\n\t\t\t'dim_location'[location_name],\r\n\t\t\t1\r\n\t\t)\r\n\r\n\tVAR __DS0SecondaryBase = \r\n\t\tSUMMARIZE(__DS0Core, 'dim_product'[category], [IsGrandTotalColumnTotal])\r\n\r\n\tVAR __DS0Secondary = \r\n\t\tTOPN(102, __DS0SecondaryBase, [IsGrandTotalColumnTotal], 1, 'dim_product'[category], 1)\r\n\r\n\tVAR __DS0BodyLimited = \r\n\t\tNATURALLEFTOUTERJOIN(\r\n\t\t\t__DS0PrimaryWindowed,\r\n\t\t\tSUBSTITUTEWITHINDEX(\r\n\t\t\t\t__DS0Core,\r\n\t\t\t\t\"ColumnIndex\",\r\n\t\t\t\t__DS0Secondary,\r\n\t\t\t\t[IsGrandTotalColumnTotal],\r\n\t\t\t\tASC,\r\n\t\t\t\t'dim_product'[category],\r\n\t\t\t\tASC\r\n\t\t\t)\r\n\t\t)\r\n\r\nEVALUATE\r\n\t__DS0Secondary\r\n\r\nORDER BY\r\n\t[IsGrandTotalColumnTotal], 'dim_product'[category]\r\n\r\nEVALUATE\r\n\t__DS0BodyLimited\r\n\r\nORDER BY\r\n\t[IsGrandTotalRowTotal] DESC, 'dim_location'[location_name], [ColumnIndex]","RowCount":64}},{"name":"Execute Query","component":"AS","start":"2026-10-28T14:02:37.187Z","end":"2026-10-28T14:02:37.210Z","id":"684C592F-1583-42F1-B64B-63F2A2F71949","parentId":"f4a2c921-511b-42d3-b7c5-00d8102c2695"},{"name":"Serialize Rowset","component":"AS","start":"2026-10-28T14:02:37.210Z","end":"2026-10-28T14:02:37.210Z","id":"B597BC80-09AD-4727-9110-E4A1BAA46082","parentId":"684C592F-1583-42F1-B64B-63F2A2F71949"}],"sessionId":"b0a97d98-a8a3-4fb6-babe-538db75749cf"}