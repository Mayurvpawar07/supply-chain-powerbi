table _Measures
	lineageTag: 64d8cd78-988e-468e-a6af-3c055605e608

	measure 'PO Lines' = COUNTROWS ( fact_po_lines )
		formatString: 0
		lineageTag: 6acf1536-6af7-4ae5-861a-c91ce0f40578

	measure 'On-Time %' = DIVIDE ( SUM ( fact_po_lines[is_on_time] ), [PO Lines] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9b8b0867-f600-4add-b002-f26cd88d50c8

	measure 'In-Full %' = DIVIDE ( SUM ( fact_po_lines[is_in_full] ), [PO Lines] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 154aecc8-6d7d-460c-8d77-f402b259c181

	measure 'OTIF %' =
			
			DIVIDE (
			    CALCULATE ( [PO Lines], fact_po_lines[is_on_time] = 1, fact_po_lines[is_in_full] = 1 ),
			    [PO Lines]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e8788196-8fce-4aa7-becf-e206eae00f77

	measure Spend = SUMX ( fact_po_lines, fact_po_lines[qty_received] * fact_po_lines[unit_cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 34bd0816-65d7-4a99-a135-f2af70e72199

	measure 'Inventory Value' =
			
			VAR _d = MAX ( fact_inventory_daily[date_key] )
			RETURN CALCULATE ( SUM ( fact_inventory_daily[on_hand_value] ), fact_inventory_daily[date_key] = _d )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0550f1f7-1e8c-441e-99ea-a3d03c9b1033

	measure 'Inventory Value (SLOW)' =
			
			VAR _d = MAX ( fact_inventory_daily[date_key] )
			RETURN
			    SUMX (
			        FILTER ( fact_inventory_daily, fact_inventory_daily[date_key] = _d ),
			        fact_inventory_daily[on_hand_qty] * RELATED ( dim_product[unit_cost] )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 265b5b74-0a46-43aa-b126-383545b95db8

	measure 'OTIF % (SLOW)' =
			
			DIVIDE (
			    COUNTROWS (
			        FILTER (
			            fact_po_lines,
			            fact_po_lines[received_date_key] <= fact_po_lines[promised_date_key]
			                && fact_po_lines[qty_received] >= fact_po_lines[qty_ordered]
			        )
			    ),
			    COUNTROWS ( fact_po_lines )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b706ab6a-f3d1-4129-bd08-8b031ec73f25

	measure 'Inventory Value vs PY (SLOW)' =
			
			DIVIDE (
			    CALCULATE ( [Inventory Value (SLOW)], DATEADD ( dim_date[date], -1, YEAR ) ),
			    [Inventory Value (SLOW)]
			) - 1
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 23ba8297-b9c6-40ba-aa16-06404022e66a

	measure 'Inventory Value vs PY' =
			
			VAR _cur = [Inventory Value]
			VAR _py  = CALCULATE ( [Inventory Value], DATEADD ( dim_date[date], -1, YEAR ) )
			RETURN DIVIDE ( _cur, _py ) - 1
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 1f7ffe28-53fb-4b6f-8dd5-863681257a5e

	measure 'Late Lines' = [PO Lines] - SUM ( fact_po_lines[is_on_time] )
		formatString: 0
		lineageTag: 00241d6a-5b37-4009-9d85-4c0a096f3cfd

	measure 'Short Lines' = [PO Lines] - SUM ( fact_po_lines[is_in_full] )
		formatString: 0
		lineageTag: 5656b2de-6504-42fe-a474-8eaa8be02fd8

	measure 'A-Class Share' = ```
			
			   DIVIDE (
			       CALCULATE ( [Inventory Value], dim_product[abc_class] = "A" ),
			       [Inventory Value]
			   )
			```
		formatString: 0%;-0%;0%
		lineageTag: aaff9827-81b5-4e9a-bb48-8d5240b4c712

	column Column1
		dataType: string
		isHidden
		lineageTag: 2a170258-488e-46ee-85d3-3a450dc90162
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				  Source

	annotation PBI_ResultType = Table

